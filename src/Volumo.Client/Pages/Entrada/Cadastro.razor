@page "/cadastro"
@layout EntradaLayout
@using System.ComponentModel.DataAnnotations
@inject ApiVolumo Api

<PageTitle>Criar conta de personal · Volumo</PageTitle>

<SectionContent SectionName="entrada-lado">
    <div class="lado pilha">
        <p class="rotulo">Conta de personal</p>
        <p class="lado-frase">Monte o treino uma vez, mande para quantos alunos quiser.</p>
        <p>Seus alunos entram por convite e não pagam nada. O CREF é opcional agora, mas aparece para os alunos quando você informa.</p>
    </div>
</SectionContent>

@if (_enviadoPara is not null)
{
    <div class="pilha" style="--espaco: 20px">
        <h1>Confira o e-mail</h1>
        <p>Mandamos um link de confirmação para <strong>@_enviadoPara</strong>. Abra no celular ou no computador para ativar a conta.</p>
        <p class="secundario">O link chega em até alguns minutos. Olhe também a caixa de spam.</p>
        <a class="botao" href="entrar">Ir para o login</a>
    </div>
}
else
{
    <div class="pilha" style="--espaco: 28px">
        <h1>Criar conta</h1>
        <EditForm Model="_form" OnValidSubmit="CadastrarAsync" class="formulario" FormName="cadastro">
            <DataAnnotationsValidator />
            <div class="campo">
                <label class="rotulo" for="nome">Nome</label>
                <InputText id="nome" autocomplete="name" @bind-Value="_form.Nome" />
                <ValidationMessage For="() => _form.Nome" />
            </div>
            <div class="campo">
                <label class="rotulo" for="email">E-mail</label>
                <InputText id="email" type="email" autocomplete="email" @bind-Value="_form.Email" />
                <ValidationMessage For="() => _form.Email" />
            </div>
            <div class="campo">
                <label class="rotulo" for="senha">Senha</label>
                <InputText id="senha" type="password" autocomplete="new-password" @bind-Value="_form.Senha" />
                <span class="campo-ajuda">Pelo menos 10 caracteres. Uma frase curta funciona melhor que símbolos.</span>
                <ValidationMessage For="() => _form.Senha" />
            </div>
            <div class="campo">
                <label class="rotulo" for="cref">CREF <span class="secundario">(opcional)</span></label>
                <InputText id="cref" placeholder="000000-G/SP" autocomplete="off" @bind-Value="_form.Cref" />
                <ValidationMessage For="() => _form.Cref" />
            </div>

            <VerificacaoHumana @ref="_verificacao" TokenChanged="t => _tokenTurnstile = t" />

            @if (_erro is not null)
            {
                <p class="aviso aviso-erro" role="alert">@_erro</p>
            }

            <button type="submit" class="botao botao-principal botao-largo" disabled="@(_enviando || string.IsNullOrEmpty(_tokenTurnstile))">Criar conta</button>
        </EditForm>
        <p class="links-secundarios"><a href="entrar">Já tenho conta</a></p>
    </div>
}

@code {
    private readonly FormularioDeCadastro _form = new();
    private VerificacaoHumana? _verificacao;
    private string? _tokenTurnstile;
    private string? _erro;
    private string? _enviadoPara;
    private bool _enviando;

    private async Task CadastrarAsync()
    {
        _enviando = true;
        _erro = null;
        var pedido = new CadastroDePersonal(_form.Nome.Trim(), _form.Email.Trim(), _form.Senha, string.IsNullOrWhiteSpace(_form.Cref) ? null : _form.Cref, _tokenTurnstile!);
        var resultado = await Api.PostAsync("auth/cadastro/personal", pedido);
        _enviando = false;

        if (resultado.Ok)
        {
            _enviadoPara = pedido.Email;
            return;
        }

        _erro = resultado.Erro;
        if (_verificacao is not null)
        {
            await _verificacao.ReiniciarAsync(); // cada token do anti-robô vale uma vez
        }
    }

    private sealed class FormularioDeCadastro
    {
        [Required(ErrorMessage = "Informe seu nome."), StringLength(120)]
        public string Nome { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o e-mail."), EmailAddress(ErrorMessage = "E-mail inválido."), StringLength(256)]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Crie uma senha."), MinLength(10, ErrorMessage = "A senha precisa ter pelo menos 10 caracteres."), StringLength(128)]
        public string Senha { get; set; } = string.Empty;

        [StringLength(20)]
        public string? Cref { get; set; }
    }
}
