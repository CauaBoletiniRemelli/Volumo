@page "/treinos/{TreinoId:guid}"
@attribute [Authorize(Roles = "Aluno")]
@using Volumo.Shared.Sessoes
@using Volumo.Shared.Treinos
@inject TreinosDoAluno Treinos
@inject NavigationManager Navegacao
@inject ApiVolumo Api
@inject SessaoDoUsuario Sessao

<PageTitle>@(_treino?.Nome ?? "Treino") · Volumo</PageTitle>

<header class="cabecalho-pagina">
    <p class="rotulo"><a href="treinos?todos=true">Treinos</a></p>
    <h1>@(_treino?.Nome ?? "Treino")</h1>
    @if (_treino is not null && Rotulos.Dias(_treino.DiasOuVazio) is { } dias)
    {
        <p class="secundario">@(Proprio ? "Marcado para" : "Seu personal marcou para") @dias</p>
    }
</header>

@if (_treino is null)
{
    <p class="secundario">@(_erro ?? "Carregando.")</p>
}
else
{
    <div class="pilha" style="--espaco: 20px">
        @if (_emAndamento is not null && _emAndamento.TreinoId != TreinoId)
        {
            <div class="aviso pilha" style="--espaco: 12px">
                <p>Você tem outro treino em andamento, com <span class="numero">@_emAndamento.Series.Count</span> séries feitas.</p>
                <div class="linha-de-botoes">
                    <a class="botao" href="treinos/@_emAndamento.TreinoId/sessao">Continuar aquele</a>
                    <button class="botao botao-texto texto-erro" @onclick="DescartarOutroAsync">Descartar e começar este</button>
                </div>
            </div>
        }
        else if (_emAndamento is not null || _treino.CardiosOuVazio.Count == 0 || _treino.Itens.Count == 0)
        {
            <a class="botao botao-principal botao-largo botao-grande" href="treinos/@TreinoId/sessao">
                @(_emAndamento is null ? "Começar treino" : "Continuar treino")
            </a>
        }
        else
        {
            @* Com cardio e musculação, o aluno escolhe por onde começar; a recomendação do personal vem destacada. *@
            var momento = _treino.MomentoDoCardio;
            <div class="pilha" style="--espaco: 10px">
                <p class="rotulo">
                    @(momento switch
                    {
                        MomentoDoCardio.Antes when Proprio => "Você planejou o cardio antes",
                        MomentoDoCardio.Depois when Proprio => "Você planejou o cardio depois",
                        MomentoDoCardio.Antes => "Seu personal recomenda o cardio antes",
                        MomentoDoCardio.Depois => "Seu personal recomenda o cardio depois",
                        _ => "Escolha por onde começar",
                    })
                </p>
                <a class="botao botao-largo botao-grande @(momento == MomentoDoCardio.Depois ? null : "botao-principal")" href="treinos/@TreinoId/sessao?cardio=antes">
                    Começar pelo cardio
                </a>
                <a class="botao botao-largo botao-grande @(momento == MomentoDoCardio.Depois ? "botao-principal" : null)" href="treinos/@TreinoId/sessao?cardio=depois">
                    Começar pela musculação
                </a>
            </div>
        }

        @if (_treino.MomentoDoCardio == MomentoDoCardio.Antes)
        {
            <SecaoDeCardio Cardios="_treino.CardiosOuVazio" Momento="_treino.MomentoDoCardio" />
        }

        <ol class="itens-do-treino">
            @foreach (var item in _treino.Itens.OrderBy(i => i.Ordem))
            {
                <li class="painel">
                    <div class="painel-cabecalho">
                        <div class="com-foto">
                            <FotoDoExercicio Url="@item.FotoUrl" Nome="@item.NomeDoExercicio" />
                            <h3>@item.NomeDoExercicio</h3>
                        </div>
                        <span class="secundario"><span class="numero">@item.Series.Count</span> @Rotulos.Plural(item.Series.Count, "série", "séries")</span>
                    </div>
                    <div class="painel-corpo pilha" style="--espaco: 8px">
                        @foreach (var grupo in item.Series.GroupBy(s => (s.Tipo, s.RepeticoesMinimas, s.RepeticoesMaximas, s.CargaKg, s.DescansoSegundos)))
                        {
                            <p class="prescricao">
                                <span class="numero">@grupo.Count() × @Rotulos.Repeticoes(grupo.Key.RepeticoesMinimas, grupo.Key.RepeticoesMaximas)</span>
                                @if (grupo.Key.CargaKg is { } carga)
                                {
                                    <span class="numero"> · @Rotulos.Kg(carga) kg</span>
                                }
                                <span class="secundario"> · @Rotulos.Descanso(grupo.Key.DescansoSegundos)@Rotulos.Marcador(grupo.Key.Tipo)</span>
                            </p>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Observacao))
                        {
                            <p><span class="rotulo">@(Proprio ? "Observação" : "Personal")</span> <span class="secundario">@item.Observacao</span></p>
                        }
                        <ObservacaoDoAluno TreinoId="TreinoId" ExercicioId="item.ExercicioId" Texto="@item.ObservacaoDoAluno"
                                           TextoChanged="texto => AtualizarObservacao(item, texto)" />
                    </div>
                </li>
            }
        </ol>

        @if (_treino.MomentoDoCardio != MomentoDoCardio.Antes)
        {
            <SecaoDeCardio Cardios="_treino.CardiosOuVazio" Momento="_treino.MomentoDoCardio" />
        }

        <section class="painel" aria-labelledby="evolucao-titulo">
            <div class="painel-cabecalho"><h3 id="evolucao-titulo">Evolução</h3></div>
            <div class="painel-corpo">
                @if (_evolucao is null)
                {
                    <p class="secundario">@(_erroEvolucao ?? "Carregando.")</p>
                }
                else
                {
                    <GraficoDeEvolucao Evolucao="_evolucao" />
                }
            </div>
        </section>

        <section class="painel">
            <div class="painel-corpo">
                <ExportarArquivo Titulo="Exportar o treino (exercícios e evolução)" Caminho="@($"treinos/{TreinoId}/exportar")" NomeDoArquivo="@_treino.Nome" />
            </div>
        </section>

        @if (Proprio && !Sessao.Offline)
        {
            @* Treino montado pela própria pessoa: ela mesma altera e arquiva (o prescrito, só o personal). *@
            <section class="painel" aria-labelledby="dias-titulo">
                <div class="painel-cabecalho"><h3 id="dias-titulo">Dias da semana</h3></div>
                <div class="painel-corpo pilha" style="--espaco: 10px">
                    <EscolhaDeDias TreinoId="TreinoId" Nome="@_treino.Nome" Dias="_treino.DiasOuVazio" DiasChanged="AtualizarDiasAsync" />
                    <p class="campo-ajuda">Os dias marcados aparecem no calendário e o treino ganha a etiqueta "Hoje" na lista.</p>
                </div>
            </section>

            <section class="painel">
                <div class="painel-corpo pilha" style="--espaco: 12px">
                    <div class="linha-de-botoes">
                        <a class="botao" href="treinos/@TreinoId/editar">Editar treino</a>
                        @if (_confirmandoArquivar)
                        {
                            <button class="botao botao-texto texto-erro" disabled="@_arquivando" @onclick="ArquivarAsync">Confirmar</button>
                            <button class="botao botao-texto" @onclick="() => _confirmandoArquivar = false">Manter</button>
                        }
                        else
                        {
                            <button class="botao botao-texto" @onclick="() => _confirmandoArquivar = true">Arquivar</button>
                        }
                    </div>
                    @if (_erroArquivar is not null)
                    {
                        <p class="aviso aviso-erro" role="alert">@_erroArquivar</p>
                    }
                    <p class="campo-ajuda">Arquivar tira o treino da lista. Os treinos que você já registrou continuam no histórico.</p>
                </div>
            </section>
        }
    </div>
}

@code {
    private TreinoDetalhe? _treino;
    private SessaoEmAndamento? _emAndamento;
    private EvolucaoDoTreino? _evolucao;
    private string? _erro;
    private string? _erroEvolucao;
    private bool _confirmandoArquivar;
    private bool _arquivando;
    private string? _erroArquivar;

    [Parameter]
    public Guid TreinoId { get; set; }

    /// <summary>Montado pela própria pessoa (sem personal): ela altera e arquiva.</summary>
    private bool Proprio => _treino is { PersonalId: null };

    private async Task ArquivarAsync()
    {
        _arquivando = true;
        var resultado = await Api.PostAsync($"treinos/{TreinoId}/inativar");
        _arquivando = false;
        _erroArquivar = resultado.Erro;
        if (resultado.Ok)
        {
            await Treinos.EsquecerCopiaDoTreinoAsync(TreinoId);
            Navegacao.NavigateTo("treinos?todos=true");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var treino = await Treinos.DetalheAsync(TreinoId);
        _treino = treino.Valor;
        _erro = treino.Erro;
        _emAndamento = await Treinos.EmAndamentoAsync();
        if (_treino is not null)
        {
            StateHasChanged();
            var evolucao = await Treinos.EvolucaoAsync(TreinoId);
            _evolucao = evolucao.Valor;
            _erroEvolucao = evolucao.Erro;
        }
    }

    private void AtualizarObservacao(ItemDoPlanoSaida item, string? texto) =>
        _treino = _treino! with { Itens = [.. _treino.Itens.Select(i => i.Id == item.Id ? i with { ObservacaoDoAluno = texto } : i)] };

    /// <summary>Dias gravados na API: a lista e o detalhe guardados no aparelho vencem para mostrar os novos.</summary>
    private async Task AtualizarDiasAsync(IReadOnlyList<DayOfWeek> dias)
    {
        _treino = _treino! with { Dias = dias };
        await Treinos.EsquecerCopiaDoTreinoAsync(TreinoId);
    }

    private async Task DescartarOutroAsync()
    {
        await Treinos.DescartarEmAndamentoAsync();
        Navegacao.NavigateTo($"treinos/{TreinoId}/sessao");
    }
}
