@page "/treinos"
@attribute [Authorize(Roles = "Aluno")]
@using Volumo.Shared.Sessoes
@using Volumo.Shared.Treinos
@inject TreinosDoAluno Treinos
@inject SincronizacaoDeSessoes Sincronizacao

<PageTitle>Treinos · Volumo</PageTitle>

<header class="cabecalho-pagina">
    <h1>Treinos</h1>
    <button type="button" class="botao botao-texto" disabled="@_atualizando" @onclick="() => CarregarAsync(atualizar: true)">@(_atualizando ? "Atualizando" : "Atualizar")</button>
</header>

<div class="pilha" style="--espaco: 24px">
    <IndicadorDeSincronizacao />

    @if (_emAndamento is not null && _treinos?.Find(t => t.Id == _emAndamento.TreinoId) is { } atual)
    {
        <a class="em-andamento" href="treinos/@atual.Id/sessao">
            <span class="rotulo">Em andamento</span>
            <span class="treino-nome">@atual.Nome</span>
            <span class="secundario"><span class="numero">@_emAndamento.Series.Count</span> @Rotulos.Plural(_emAndamento.Series.Count, "série feita", "séries feitas") · continuar</span>
        </a>
    }

    @if (_treinos is null)
    {
        <p class="secundario">@(_erro ?? "Carregando.")</p>
    }
    else if (_treinos.Count == 0)
    {
        <div class="painel painel-corpo">
            <p>Seu personal ainda não mandou nenhum treino. Assim que o treino for montado, aparece aqui.</p>
        </div>
    }
    else
    {
        <ul class="lista painel">
            @foreach (var treino in _treinos)
            {
                <li>
                    <a class="treino-nome link-largo" href="treinos/@treino.Id">@treino.Nome</a>
                    <span class="secundario"><span class="numero">@treino.QuantidadeDeExercicios</span> @Rotulos.Plural(treino.QuantidadeDeExercicios, "exercício", "exercícios")</span>
                </li>
            }
        </ul>
    }

    @if (_sessoes is { Count: > 0 })
    {
        <section class="painel">
            <div class="painel-cabecalho"><h2>Últimos treinos</h2></div>
            <ul class="lista">
                @foreach (var sessao in _sessoes.Take(5))
                {
                    <li>
                        <a class="link-largo" href="historico/@sessao.Id">
                            <span class="treino-nome">@(sessao.NomeDoTreino ?? "Treino livre")</span>
                            <span class="secundario numero"> · @Rotulos.Data(sessao.IniciadaEm)</span>
                        </a>
                        <span class="secundario">@Rotulos.NumerosDaSessao(sessao)</span>
                    </li>
                }
            </ul>
        </section>
    }
</div>

@code {
    private List<TreinoResumo>? _treinos;
    private List<SessaoResumo>? _sessoes;
    private SessaoEmAndamento? _emAndamento;
    private string? _erro;

    private bool _atualizando;

    protected override Task OnInitializedAsync() => CarregarAsync(atualizar: false);

    /// <summary>
    /// Usa a cópia do aparelho enquanto ela vale (sem chamar a API); só quando veio da API baixa de novo
    /// os detalhes para offline. O botão "Atualizar" força a busca.
    /// </summary>
    private async Task CarregarAsync(bool atualizar)
    {
        _atualizando = true;
        try
        {
            var treinos = await Treinos.ListarAsync(atualizar);
            _treinos = treinos.Valor;
            _erro = treinos.Erro;
            _emAndamento = await Treinos.EmAndamentoAsync();
            _sessoes = await Treinos.SessoesAsync();
            StateHasChanged();

            await Sincronizacao.IniciarAsync();
            if (_treinos is not null && !treinos.DoAparelho)
            {
                // Depois da sincronização, para o histórico já incluir o que acabou de subir.
                _sessoes = await Treinos.BaixarParaOfflineAsync(_treinos) ?? _sessoes;
            }
        }
        finally
        {
            _atualizando = false;
        }
    }
}
