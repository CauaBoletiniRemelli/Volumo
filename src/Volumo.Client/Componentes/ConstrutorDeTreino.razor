@* Montagem de treino ou modelo. Edita uma cópia local e entrega o plano inteiro: a API substitui tudo.
   Duas abas no mesmo plano: musculação e cardio. Cada exercício recolhe para a lista não crescer demais. *@
@using System.Globalization
@using Volumo.Shared.Treinos
@inject ApiVolumo Api

<div class="construtor pilha" style="--espaco: 24px">
    <div class="campo nome-do-plano">
        <label class="rotulo" for="nome-do-plano">Nome</label>
        <input id="nome-do-plano" maxlength="@NomeMaximo" placeholder="Treino A · Peito e tríceps" @bind="_nome" />
    </div>

    <div class="abas" role="tablist" aria-label="Partes do treino">
        <button type="button" role="tab" id="aba-musculacao" class="aba @(_aba == Aba.Musculacao ? "aba-ativa" : null)"
                aria-selected="@(_aba == Aba.Musculacao ? "true" : "false")" aria-controls="painel-musculacao" @onclick="() => TrocarAba(Aba.Musculacao)">
            Musculação <span class="numero aba-contagem">@_itens.Count</span>
        </button>
        <button type="button" role="tab" id="aba-cardio" class="aba @(_aba == Aba.Cardio ? "aba-ativa" : null)"
                aria-selected="@(_aba == Aba.Cardio ? "true" : "false")" aria-controls="painel-cardio" @onclick="() => TrocarAba(Aba.Cardio)">
            Cardio <span class="numero aba-contagem">@_cardios.Count</span>
        </button>
    </div>

    @if (_aba == Aba.Musculacao)
    {
        <div id="painel-musculacao" role="tabpanel" aria-labelledby="aba-musculacao" class="pilha" style="--espaco: 16px">
            @if (_itens.Count == 0)
            {
                <p class="painel lista-vazia">Nenhum exercício ainda. Use "Adicionar exercício" para começar.</p>
            }
            else if (_itens.Count > 1)
            {
                var todosAbertos = _itens.TrueForAll(i => i.Expandido);
                <button type="button" class="botao botao-texto alternar-todos" @onclick="() => _itens.ForEach(i => i.Expandido = !todosAbertos)">
                    @(todosAbertos ? "Recolher todos" : "Expandir todos")
                </button>
            }

            <ol class="itens">
                @for (var i = 0; i < _itens.Count; i++)
                {
                    var indice = i;
                    var item = _itens[indice];
                    <li class="item painel" @key="item">
                        <div class="item-cabecalho">
                            <button type="button" class="expandir" aria-expanded="@(item.Expandido ? "true" : "false")" aria-controls="item-corpo-@indice"
                                    aria-label="@(item.Expandido ? "Recolher" : "Expandir") @item.Nome" @onclick="() => item.Expandido = !item.Expandido">
                                <span class="seta @(item.Expandido ? "seta-aberta" : null)" aria-hidden="true"></span>
                                <span class="item-ordem numero">@(indice + 1)</span>
                                <span class="item-titulo">
                                    <span class="item-nome">@item.Nome</span>
                                    @if (!item.Expandido)
                                    {
                                        <span class="item-resumo secundario">@Resumo(item)</span>
                                    }
                                </span>
                            </button>
                            <FotoDoExercicio Url="@item.FotoUrl" Nome="@item.Nome" />
                            <div class="item-acoes">
                                <button type="button" class="botao-icone" title="Subir" aria-label="Subir @item.Nome" disabled="@(indice == 0)" @onclick="() => Mover(_itens, indice, -1)">↑</button>
                                <button type="button" class="botao-icone" title="Descer" aria-label="Descer @item.Nome" disabled="@(indice == _itens.Count - 1)" @onclick="() => Mover(_itens, indice, 1)">↓</button>
                                <button type="button" class="botao-icone" title="Remover" aria-label="Remover @item.Nome" @onclick="() => _itens.RemoveAt(indice)">×</button>
                            </div>
                        </div>

                        @if (item.Expandido)
                        {
                            <div id="item-corpo-@indice">
                                <div class="series" role="table" aria-label="Séries de @item.Nome">
                                    <div class="serie serie-titulos" role="row">
                                        <span role="columnheader">Série</span>
                                        <span role="columnheader">Tipo</span>
                                        <span role="columnheader">Reps</span>
                                        <span role="columnheader">Descanso (s)</span>
                                        <span role="columnheader">Carga (kg)</span>
                                        <span role="columnheader"><span class="visualmente-oculto">Remover</span></span>
                                    </div>
                                    @for (var s = 0; s < item.Series.Count; s++)
                                    {
                                        var indiceSerie = s;
                                        var serie = item.Series[indiceSerie];
                                        <div class="serie" role="row" @key="serie">
                                            <span class="serie-numero numero" role="cell">@(indiceSerie + 1)</span>
                                            <span role="cell">
                                                <select aria-label="Tipo da série @(indiceSerie + 1)" @bind="serie.Tipo">
                                                    <option value="@TipoDeSerie.Trabalho">Trabalho</option>
                                                    <option value="@TipoDeSerie.Aquecimento">Aquecimento</option>
                                                    <option value="@TipoDeSerie.Preparatoria">Preparatória</option>
                                                </select>
                                            </span>
                                            <span class="serie-reps" role="cell">
                                                <input type="number" min="1" max="100" aria-label="Repetições mínimas" @bind="serie.RepeticoesMinimas" />
                                                <span class="secundario">a</span>
                                                <input type="number" min="1" max="100" aria-label="Repetições máximas" @bind="serie.RepeticoesMaximas" />
                                            </span>
                                            <span role="cell">
                                                <input type="number" min="0" max="900" step="15" aria-label="Descanso em segundos" @bind="serie.DescansoSegundos" />
                                            </span>
                                            <span role="cell">
                                                <input type="number" min="0" max="1000" step="0.5" placeholder="livre" aria-label="Carga em kg" @bind="serie.CargaKg" />
                                            </span>
                                            <span role="cell">
                                                <button type="button" class="botao-icone" aria-label="Remover série @(indiceSerie + 1)" disabled="@(item.Series.Count == 1)" @onclick="() => item.Series.RemoveAt(indiceSerie)">×</button>
                                            </span>
                                        </div>
                                    }
                                </div>

                                <div class="item-rodape">
                                    <div class="series-acoes">
                                        <button type="button" class="botao botao-texto" disabled="@(item.Series.Count >= MaximoSeries)" @onclick="() => AdicionarSerie(item)">+ Série</button>
                                        @if (_presets is { Count: > 0 })
                                        {
                                            @* Recriado a cada aplicação (@key) para voltar a mostrar "Aplicar preset". *@
                                            <select class="aplicar-preset" @key="item.Aplicacoes" aria-label="Aplicar preset de séries em @item.Nome"
                                                    @onchange="e => AplicarPreset(item, e.Value as string)">
                                                <option value="">Aplicar preset</option>
                                                @foreach (var preset in _presets)
                                                {
                                                    <option value="@preset.Id">@preset.Nome · @Rotulos.ResumoDoPreset(preset.Series)</option>
                                                }
                                            </select>
                                        }
                                        @if (!item.SalvandoPreset)
                                        {
                                            <button type="button" class="botao botao-texto" @onclick="() => AbrirSalvarPreset(item)">Salvar como preset</button>
                                        }
                                    </div>
                                    @if (item.SeriesAntesDoPreset is not null)
                                    {
                                        <p class="campo-ajuda preset-aplicado" role="status">
                                            Séries trocadas pelo preset.
                                            <button type="button" class="botao botao-texto" @onclick="() => DesfazerPreset(item)">Desfazer</button>
                                        </p>
                                    }
                                    @if (item.SalvandoPreset)
                                    {
                                        <div class="salvar-preset">
                                            <div class="campo">
                                                <label class="rotulo" for="preset-nome-@indice">Nome do preset</label>
                                                <input id="preset-nome-@indice" maxlength="60" placeholder="Pirâmide do peito" @bind="item.NomeDoPreset" />
                                            </div>
                                            <div class="linha-de-botoes">
                                                <button type="button" class="botao botao-principal" disabled="@_salvandoPreset" @onclick="() => SalvarPresetAsync(item)">Salvar preset</button>
                                                <button type="button" class="botao" @onclick="() => item.SalvandoPreset = false">Cancelar</button>
                                            </div>
                                            <p class="campo-ajuda">Guarda o tipo, as repetições e o descanso destas séries (sem a carga) para usar em outros exercícios.</p>
                                        </div>
                                    }
                                    @if (item.MensagemDoPreset is { } mensagem)
                                    {
                                        <p class="aviso @(item.PresetSalvo ? "aviso-ok" : "aviso-erro")" role="status">@mensagem</p>
                                    }
                                    <div class="campo observacao">
                                        <label class="rotulo" for="obs-@indice">Observação</label>
                                        <input id="obs-@indice" maxlength="500" placeholder="Cadência, pegada, ajuste do aparelho..." @bind="item.Observacao" />
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.ObservacaoDoAluno))
                                {
                                    @* Escrita pelo aluno: o personal só lê (fica guardada à parte e não muda ao salvar o treino). *@
                                    <p class="campo-ajuda"><span class="rotulo">Anotação do aluno</span> @item.ObservacaoDoAluno</p>
                                }
                            </div>
                        }
                    </li>
                }
            </ol>

            @if (_buscando)
            {
                <BuscaDeExercicio SemGrupo="GrupoMuscular.Cardio" PodeCriar="PodeCriarExercicio" OnEscolher="AdicionarExercicio" OnFechar="() => _buscando = false" />
            }
            else if (_itens.Count < MaximoItens)
            {
                <button type="button" class="botao botao-largo" @onclick="() => _buscando = true">+ Adicionar exercício</button>
            }
        </div>
    }
    else
    {
        <div id="painel-cardio" role="tabpanel" aria-labelledby="aba-cardio" class="pilha" style="--espaco: 16px">
            @if (_cardios.Count == 0)
            {
                <p class="painel lista-vazia">Sem cardio neste treino. Use "Adicionar cardio" para incluir esteira, bicicleta e outros.</p>
            }
            else
            {
                <fieldset class="momento painel painel-corpo">
                    <legend class="rotulo">Quando fazer o cardio</legend>
                    <div class="momento-opcoes">
                        @foreach (var momento in new[] { MomentoDoCardio.Antes, MomentoDoCardio.Depois, MomentoDoCardio.AlunoEscolhe })
                        {
                            <label class="marcar">
                                <input type="radio" name="momento-do-cardio" checked="@(_momento == momento)" @onchange="() => _momento = momento" />
                                <span>@Rotulos.De(momento)</span>
                            </label>
                        }
                    </div>
                    <p class="campo-ajuda">@(DoProprioAluno ? "Aparece como lembrete ao começar o treino; dá para trocar na hora." : "O aluno vê a sua recomendação ao começar o treino e ainda pode trocar a ordem.")</p>
                </fieldset>
            }

            <ol class="itens">
                @for (var c = 0; c < _cardios.Count; c++)
                {
                    var indice = c;
                    var cardio = _cardios[indice];
                    <li class="item painel" @key="cardio">
                        <div class="item-cabecalho">
                            <span class="item-ordem numero">@(indice + 1)</span>
                            <h3 class="item-nome item-titulo">@cardio.Nome</h3>
                            <FotoDoExercicio Url="@cardio.FotoUrl" Nome="@cardio.Nome" />
                            <div class="item-acoes">
                                <button type="button" class="botao-icone" title="Subir" aria-label="Subir @cardio.Nome" disabled="@(indice == 0)" @onclick="() => Mover(_cardios, indice, -1)">↑</button>
                                <button type="button" class="botao-icone" title="Descer" aria-label="Descer @cardio.Nome" disabled="@(indice == _cardios.Count - 1)" @onclick="() => Mover(_cardios, indice, 1)">↓</button>
                                <button type="button" class="botao-icone" title="Remover" aria-label="Remover @cardio.Nome" @onclick="() => _cardios.RemoveAt(indice)">×</button>
                            </div>
                        </div>
                        <div class="cardio-campos">
                            <div class="campo cardio-duracao">
                                <label class="rotulo" for="cardio-min-@indice">Duração (min)</label>
                                <input id="cardio-min-@indice" type="number" inputmode="numeric" min="1" max="180" @bind="cardio.DuracaoMinutos" />
                            </div>
                            <div class="campo">
                                <label class="rotulo" for="cardio-obs-@indice">Intensidade</label>
                                <input id="cardio-obs-@indice" maxlength="500" placeholder="Zona 2, 6 km/h, inclinação 5%..." @bind="cardio.Observacao" />
                            </div>
                        </div>
                    </li>
                }
            </ol>

            @if (_buscandoCardio)
            {
                <BuscaDeExercicio Titulo="Adicionar cardio" SomenteGrupo="GrupoMuscular.Cardio" PodeCriar="PodeCriarExercicio" OnEscolher="AdicionarCardio" OnFechar="() => _buscandoCardio = false" />
            }
            else if (_cardios.Count < MaximoCardios)
            {
                <button type="button" class="botao botao-largo" @onclick="() => _buscandoCardio = true">+ Adicionar cardio</button>
            }
        </div>
    }

    @if ((_erroLocal ?? Erro) is { } erro)
    {
        <p class="aviso aviso-erro" role="alert">@erro</p>
    }

    <div class="linha-de-botoes">
        <button type="button" class="botao botao-principal" disabled="@Salvando" @onclick="SalvarAsync">@TextoDoBotao</button>
        @if (Cancelar is not null)
        {
            <a class="botao" href="@Cancelar">Cancelar</a>
        }
    </div>
</div>

@code {
    private const int NomeMaximo = 100;
    private const int MaximoItens = 40;
    private const int MaximoSeries = 20;
    private const int MaximoCardios = 10;

    private enum Aba { Musculacao, Cardio }

    private readonly List<ItemEditavel> _itens = [];
    private readonly List<CardioEditavel> _cardios = [];
    private string _nome = string.Empty;
    private MomentoDoCardio _momento = MomentoDoCardio.Depois;
    private Aba _aba = Aba.Musculacao;
    private bool _buscando;
    private bool _buscandoCardio;
    private string? _erroLocal;
    private bool _carregou;
    private List<PresetDeSeriesSaida>? _presets;
    private bool _salvandoPreset;

    [Parameter]
    public string? NomeInicial { get; set; }

    /// <summary>Mostra "Criar exercício" na busca (exercício personalizado é só do personal).</summary>
    [Parameter]
    public bool PodeCriarExercicio { get; set; } = true;

    /// <summary>Treino que a própria pessoa vai fazer (aluno ou personal nos próprios treinos): ajusta os textos.</summary>
    [Parameter]
    public bool DoProprioAluno { get; set; }

    [Parameter]
    public IReadOnlyList<ItemDoPlanoSaida>? ItensIniciais { get; set; }

    [Parameter]
    public IReadOnlyList<CardioDoPlanoSaida>? CardiosIniciais { get; set; }

    [Parameter]
    public MomentoDoCardio MomentoInicial { get; set; } = MomentoDoCardio.Depois;

    [Parameter, EditorRequired]
    public EventCallback<PlanoDeTreinoEntrada> OnSalvar { get; set; }

    [Parameter]
    public bool Salvando { get; set; }

    /// <summary>Erro vindo da API (a página repassa a mensagem do ProblemDetails).</summary>
    [Parameter]
    public string? Erro { get; set; }

    [Parameter]
    public string TextoDoBotao { get; set; } = "Salvar";

    [Parameter]
    public string? Cancelar { get; set; }

    protected override void OnParametersSet()
    {
        // Copia o plano só na primeira vez: depois a edição é local até salvar.
        if (_carregou)
        {
            return;
        }

        _carregou = true;
        _nome = NomeInicial ?? string.Empty;
        _momento = MomentoInicial;
        var itens = ItensIniciais?.OrderBy(i => i.Ordem).ToList() ?? [];
        foreach (var item in itens)
        {
            // Plano aberto para editar começa recolhido (só o nome e o resumo de cada exercício).
            _itens.Add(new ItemEditavel(item.ExercicioId, item.NomeDoExercicio)
            {
                Observacao = item.Observacao,
                ObservacaoDoAluno = item.ObservacaoDoAluno,
                FotoUrl = item.FotoUrl,
                Series = [.. item.Series.Select(SerieEditavel.De)],
                Expandido = itens.Count == 1,
            });
        }

        foreach (var cardio in CardiosIniciais?.OrderBy(c => c.Ordem) ?? Enumerable.Empty<CardioDoPlanoSaida>())
        {
            _cardios.Add(new CardioEditavel(cardio.ExercicioId, cardio.NomeDoExercicio) { DuracaoMinutos = cardio.DuracaoMinutos, Observacao = cardio.Observacao, FotoUrl = cardio.FotoUrl });
        }
    }

    /// <summary>Sem os presets (erro ou sem rede), o construtor funciona igual, só sem "Aplicar preset".</summary>
    protected override async Task OnInitializedAsync() => _presets = (await Api.GetAsync<List<PresetDeSeriesSaida>>("presets")).Valor;

    /// <summary>Troca as séries do exercício pelas do preset (sem carga). "Desfazer" volta as anteriores.</summary>
    private void AplicarPreset(ItemEditavel item, string? id)
    {
        item.Aplicacoes++;
        if (_presets?.Find(p => p.Id.ToString() == id) is not { } preset)
        {
            return;
        }

        item.SeriesAntesDoPreset = item.Series;
        item.Series = [.. preset.Series.Select(s => new SerieEditavel
        {
            Tipo = s.Tipo,
            RepeticoesMinimas = s.RepeticoesMinimas,
            RepeticoesMaximas = s.RepeticoesMaximas,
            DescansoSegundos = s.DescansoSegundos,
        })];
        item.MensagemDoPreset = null;
        _erroLocal = null;
    }

    private static void DesfazerPreset(ItemEditavel item)
    {
        item.Series = item.SeriesAntesDoPreset ?? item.Series;
        item.SeriesAntesDoPreset = null;
    }

    private static void AbrirSalvarPreset(ItemEditavel item)
    {
        item.SalvandoPreset = true;
        item.MensagemDoPreset = null;
    }

    private async Task SalvarPresetAsync(ItemEditavel item)
    {
        var problema = string.IsNullOrWhiteSpace(item.NomeDoPreset) ? "Dê um nome ao preset." : null;
        for (var s = 0; problema is null && s < item.Series.Count; s++)
        {
            problema = ProblemaNaSerie(item.Series[s]) is { } p ? $"Série {s + 1}: {p}" : null;
        }

        if (problema is not null)
        {
            (item.MensagemDoPreset, item.PresetSalvo) = (problema, false);
            return;
        }

        _salvandoPreset = true;
        var entrada = new PresetDeSeriesEntrada(
            item.NomeDoPreset!.Trim(),
            [.. item.Series.Select(s => new SerieDoPreset(s.Tipo, s.RepeticoesMinimas, s.RepeticoesMaximas, s.DescansoSegundos))]);
        var resultado = await Api.PostAsync<RecursoCriado>("presets", entrada);
        _salvandoPreset = false;
        if (!resultado.Ok)
        {
            (item.MensagemDoPreset, item.PresetSalvo) = (resultado.Erro, false);
            return;
        }

        (item.MensagemDoPreset, item.PresetSalvo) = ($"Preset \"{entrada.Nome}\" salvo. Ele já aparece em \"Aplicar preset\".", true);
        item.SalvandoPreset = false;
        item.NomeDoPreset = null;
        _presets = (await Api.GetAsync<List<PresetDeSeriesSaida>>("presets")).Valor ?? _presets;
    }

    private void TrocarAba(Aba aba)
    {
        _aba = aba;
        _buscando = false;
        _buscandoCardio = false;
    }

    /// <summary>O novo exercício abre e os outros recolhem: a tela não cresce a cada exercício.</summary>
    private void AdicionarExercicio(ExercicioResumo exercicio)
    {
        _itens.ForEach(i => i.Expandido = false);
        _itens.Add(new ItemEditavel(exercicio.Id, exercicio.Nome)
        {
            FotoUrl = exercicio.FotoUrl,
            Series = [SerieEditavel.Padrao(), SerieEditavel.Padrao(), SerieEditavel.Padrao()],
            Expandido = true,
        });
        _buscando = false;
        _erroLocal = null;
    }

    private void AdicionarCardio(ExercicioResumo exercicio)
    {
        _cardios.Add(new CardioEditavel(exercicio.Id, exercicio.Nome) { FotoUrl = exercicio.FotoUrl });
        _buscandoCardio = false;
        _erroLocal = null;
    }

    private static void AdicionarSerie(ItemEditavel item)
    {
        item.SeriesAntesDoPreset = null;
        item.Series.Add(item.Series.Count > 0 ? item.Series[^1].Copia() : SerieEditavel.Padrao());
    }

    private static void Mover<T>(List<T> lista, int indice, int direcao)
    {
        var destino = indice + direcao;
        (lista[indice], lista[destino]) = (lista[destino], lista[indice]);
    }

    /// <summary>Resumo do exercício recolhido: "3 séries · 8–12 · 20 kg".</summary>
    private static string Resumo(ItemEditavel item)
    {
        if (item.Series.Count == 0)
        {
            return "sem séries";
        }

        var primeira = item.Series[0];
        var partes = new List<string>
        {
            $"{item.Series.Count} {Rotulos.Plural(item.Series.Count, "série", "séries")}",
            item.Series.TrueForAll(s => s.RepeticoesMinimas == primeira.RepeticoesMinimas && s.RepeticoesMaximas == primeira.RepeticoesMaximas)
                ? Rotulos.Repeticoes(primeira.RepeticoesMinimas, primeira.RepeticoesMaximas)
                : "reps variadas",
        };

        if (item.Series.TrueForAll(s => s.CargaKg == primeira.CargaKg))
        {
            if (primeira.CargaKg is { } carga)
            {
                partes.Add($"{Rotulos.Kg(carga)} kg");
            }
        }
        else
        {
            partes.Add("carga variada");
        }

        return string.Join(" · ", partes);
    }

    private async Task SalvarAsync()
    {
        _erroLocal = Validar();
        if (_erroLocal is not null)
        {
            return;
        }

        var plano = new PlanoDeTreinoEntrada(
            _nome.Trim(),
            [.. _itens.Select(i => new ItemDoPlano(
                i.ExercicioId,
                [.. i.Series.Select(s => new SeriePrescrita(s.Tipo, s.RepeticoesMinimas, s.RepeticoesMaximas, s.DescansoSegundos, s.CargaKg))],
                string.IsNullOrWhiteSpace(i.Observacao) ? null : i.Observacao.Trim()))],
            [.. _cardios.Select(c => new CardioPrescrito(c.ExercicioId, c.DuracaoMinutos, string.IsNullOrWhiteSpace(c.Observacao) ? null : c.Observacao.Trim()))],
            _momento);
        await OnSalvar.InvokeAsync(plano);
    }

    /// <summary>
    /// Mesmos limites do domínio, para avisar antes de enviar. A API valida de novo. O exercício com
    /// problema abre (e a aba certa aparece) para a pessoa achar o campo.
    /// </summary>
    private string? Validar()
    {
        if (string.IsNullOrWhiteSpace(_nome))
        {
            return "Dê um nome ao treino.";
        }

        if (_itens.Count == 0 && _cardios.Count == 0)
        {
            return "Adicione pelo menos um exercício ou um cardio.";
        }

        foreach (var item in _itens)
        {
            for (var s = 0; s < item.Series.Count; s++)
            {
                if (ProblemaNaSerie(item.Series[s]) is { } problema)
                {
                    item.Expandido = true;
                    _aba = Aba.Musculacao;
                    return string.Create(CultureInfo.InvariantCulture, $"{item.Nome}, série {s + 1}: {problema}");
                }
            }
        }

        foreach (var cardio in _cardios)
        {
            if (cardio.DuracaoMinutos is < 1 or > 180)
            {
                _aba = Aba.Cardio;
                return $"{cardio.Nome}: duração entre 1 e 180 minutos.";
            }
        }

        return null;
    }

    private static string? ProblemaNaSerie(SerieEditavel serie)
    {
        if (serie.RepeticoesMinimas is < 1 or > 100 || serie.RepeticoesMaximas is < 1 or > 100)
        {
            return "repetições entre 1 e 100.";
        }

        if (serie.RepeticoesMinimas > serie.RepeticoesMaximas)
        {
            return "o mínimo de repetições não pode passar do máximo.";
        }

        if (serie.DescansoSegundos is < 0 or > 900)
        {
            return "descanso entre 0 e 900 segundos.";
        }

        return serie.CargaKg is < 0 or > 1000 ? "carga entre 0 e 1000 kg." : null;
    }

    private sealed class ItemEditavel(Guid exercicioId, string nome)
    {
        public Guid ExercicioId { get; } = exercicioId;

        public string Nome { get; } = nome;

        public string? Observacao { get; set; }

        /// <summary>Só leitura: anotação do aluno neste exercício.</summary>
        public string? ObservacaoDoAluno { get; init; }

        /// <summary>Foto do exercício (só para ver; não vai no plano salvo).</summary>
        public string? FotoUrl { get; init; }

        public List<SerieEditavel> Series { get; set; } = [];

        public bool Expandido { get; set; }

        /// <summary>Séries de antes do último preset aplicado (para "Desfazer"); nulo depois de desfazer.</summary>
        public List<SerieEditavel>? SeriesAntesDoPreset { get; set; }

        /// <summary>Muda a cada aplicação, para o seletor de preset voltar ao texto inicial.</summary>
        public int Aplicacoes { get; set; }

        public bool SalvandoPreset { get; set; }

        public string? NomeDoPreset { get; set; }

        public string? MensagemDoPreset { get; set; }

        public bool PresetSalvo { get; set; }
    }

    private sealed class CardioEditavel(Guid exercicioId, string nome)
    {
        public Guid ExercicioId { get; } = exercicioId;

        public string Nome { get; } = nome;

        public int DuracaoMinutos { get; set; } = 20;

        public string? Observacao { get; set; }

        public string? FotoUrl { get; init; }
    }

    private sealed class SerieEditavel
    {
        public TipoDeSerie Tipo { get; set; } = TipoDeSerie.Trabalho;

        public int RepeticoesMinimas { get; set; } = 8;

        public int RepeticoesMaximas { get; set; } = 12;

        public int DescansoSegundos { get; set; } = 90;

        public decimal? CargaKg { get; set; }

        public static SerieEditavel Padrao() => new();

        public static SerieEditavel De(SeriePrescrita s) => new()
        {
            Tipo = s.Tipo,
            RepeticoesMinimas = s.RepeticoesMinimas,
            RepeticoesMaximas = s.RepeticoesMaximas,
            DescansoSegundos = s.DescansoSegundos,
            CargaKg = s.CargaKg is { } carga ? Rotulos.SemZeros(carga) : null,
        };

        public SerieEditavel Copia() => (SerieEditavel)MemberwiseClone();
    }
}
