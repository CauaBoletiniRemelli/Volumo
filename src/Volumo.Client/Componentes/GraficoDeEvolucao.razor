@* Evolução de um exercício nos dias de treino: uma medida por vez (carga, repetições ou volume),
   num eixo só. Tocar ou passar o mouse num dia mostra os números dele; o último dia vem selecionado.
   Recorde de carga (maior que todos os dias anteriores) aparece em laranja, com o texto "recorde". *@
@using System.Globalization
@using Volumo.Shared.Sessoes

@if (Evolucao.Exercicios.Count == 0)
{
    <p class="secundario">O gráfico aparece depois do primeiro treino registrado.</p>
}
else
{
    var exercicio = Atual;
    var pontos = exercicio.Pontos;
    <div class="grafico pilha" style="--espaco: 14px">
        <div class="grafico-filtros">
            <label class="campo">
                <span class="rotulo">Exercício</span>
                <select @bind="ExercicioId">
                    @foreach (var opcao in Evolucao.Exercicios)
                    {
                        <option value="@opcao.ExercicioId">@opcao.NomeDoExercicio</option>
                    }
                </select>
            </label>
            <div class="escolha grafico-medidas" role="group" aria-label="Medida do gráfico">
                @foreach (var medida in Enum.GetValues<Medida>())
                {
                    <button type="button" class="escolha-opcao @(_medida == medida ? "escolha-ativa" : null)" aria-pressed="@(_medida == medida)"
                            @onclick="() => _medida = medida">@Nome(medida)</button>
                }
            </div>
        </div>

        @if (pontos.Count > 0)
        {
            var foco = Math.Clamp(_foco ?? pontos.Count - 1, 0, pontos.Count - 1);
            var ponto = pontos[foco];
            <div class="grafico-leitura" aria-live="polite">
                <span class="rotulo">@Rotulos.Data(ponto.Data)</span>
                <span class="grafico-valor numero">@Valor(ponto)</span>
                <span class="secundario">
                    <span class="numero">@Rotulos.Kg(ponto.CargaMaximaKg) kg × @ponto.RepeticoesNaCargaMaxima</span> na série mais pesada ·
                    <span class="numero">@ponto.Series</span> @Rotulos.Plural(ponto.Series, "série", "séries") ·
                    <span class="numero">@Rotulos.Kg(ponto.VolumeKg) kg</span> de volume
                </span>
                @if (Recorde(pontos, foco))
                {
                    <span class="etiqueta etiqueta-recorde">Recorde de carga</span>
                }
            </div>

            var escala = Escala(pontos);
            <svg class="grafico-svg" viewBox="0 0 @L @A" role="img" aria-label="@($"{Nome(_medida)} de {exercicio.NomeDoExercicio} em {pontos.Count} dias de treino")"
                 @onmouseleave="() => _foco = null">
                @foreach (var marca in escala.Marcas)
                {
                    var y = Y(marca, escala);
                    <line class="grafico-grade" x1="@N(EsqX)" x2="@N(L - DirX)" y1="@N(y)" y2="@N(y)" />
                    <!text class="grafico-eixo" x="@N(EsqX - 6)" y="@N(y + 3.5)" text-anchor="end">@Marca(marca)</!text>
                }

                @foreach (var indice in RotulosDeData(pontos.Count))
                {
                    <!text class="grafico-eixo" x="@N(X(indice, pontos.Count))" y="@N(A - 6)"
                          text-anchor="@(pontos.Count == 1 ? "middle" : indice == 0 ? "start" : indice == pontos.Count - 1 ? "end" : "middle")">@Curta(pontos[indice].Data)</!text>
                }

                <line class="grafico-mira" x1="@N(X(foco, pontos.Count))" x2="@N(X(foco, pontos.Count))" y1="@N(TopoY)" y2="@N(A - BaseY)" />

                @if (pontos.Count > 1)
                {
                    <polyline class="grafico-linha" points="@string.Join(' ', pontos.Select((p, i) => $"{N(X(i, pontos.Count))},{N(Y(Medir(p), escala))}"))" />
                }

                @for (var i = 0; i < pontos.Count; i++)
                {
                    var indice = i;
                    <circle class="grafico-ponto @(Recorde(pontos, indice) ? "grafico-ponto-recorde" : null) @(indice == foco ? "grafico-ponto-foco" : null)"
                            cx="@N(X(indice, pontos.Count))" cy="@N(Y(Medir(pontos[indice]), escala))" r="@N(indice == foco ? 5.5 : 4)" />
                }

                @* Alvos de toque: uma faixa vertical inteira por dia, maior que o ponto. *@
                @for (var i = 0; i < pontos.Count; i++)
                {
                    var indice = i;
                    var largura = (L - EsqX - DirX) / Math.Max(1, pontos.Count - 1);
                    var inicio = pontos.Count == 1 ? EsqX : X(indice, pontos.Count) - largura / 2;
                    <rect class="grafico-alvo" x="@N(Math.Max(EsqX, inicio))" y="0" width="@N(pontos.Count == 1 ? L - EsqX - DirX : largura)" height="@A"
                          @onmouseenter="() => _foco = indice" @onclick="() => _foco = indice" />
                }
            </svg>

            <details class="grafico-tabela">
                <summary>Ver como tabela</summary>
                <table>
                    <thead>
                        <tr><th>Dia</th><th>Série mais pesada</th><th>Repetições</th><th>Volume</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var linha in pontos.Reverse())
                        {
                            <tr>
                                <td class="numero">@Rotulos.Data(linha.Data)</td>
                                <td class="numero">@Rotulos.Kg(linha.CargaMaximaKg) kg × @linha.RepeticoesNaCargaMaxima</td>
                                <td class="numero">@linha.Repeticoes</td>
                                <td class="numero">@Rotulos.Kg(linha.VolumeKg) kg</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </details>
        }
    </div>
}

@code {
    // Área do desenho (unidades do viewBox). Largura perto da de um celular, para o texto não encolher demais.
    private const double L = 360;
    private const double A = 190;
    private const double EsqX = 40;
    private const double DirX = 10;
    private const double TopoY = 12;
    private const double BaseY = 24;

    private Guid? _exercicioId;
    private Medida _medida = Medida.Carga;
    private int? _foco;

    [Parameter, EditorRequired]
    public EvolucaoDoTreino Evolucao { get; set; } = null!;

    private string ExercicioId
    {
        get => Atual.ExercicioId.ToString();
        set
        {
            _exercicioId = Guid.TryParse(value, out var id) ? id : null;
            _foco = null;
        }
    }

    private EvolucaoDoExercicio Atual =>
        Evolucao.Exercicios.FirstOrDefault(e => e.ExercicioId == _exercicioId) ?? Evolucao.Exercicios[0];

    private enum Medida
    {
        Carga,
        Repeticoes,
        Volume,
    }

    private static string Nome(Medida medida) => medida switch
    {
        Medida.Carga => "Carga",
        Medida.Repeticoes => "Repetições",
        _ => "Volume",
    };

    private decimal Medir(PontoDeEvolucao ponto) => _medida switch
    {
        Medida.Carga => ponto.CargaMaximaKg,
        Medida.Repeticoes => ponto.Repeticoes,
        _ => ponto.VolumeKg,
    };

    private string Valor(PontoDeEvolucao ponto) => _medida switch
    {
        Medida.Carga => $"{Rotulos.Kg(ponto.CargaMaximaKg)} kg",
        Medida.Repeticoes => $"{ponto.Repeticoes} {Rotulos.Plural(ponto.Repeticoes, "repetição", "repetições")}",
        _ => $"{Rotulos.Kg(ponto.VolumeKg)} kg",
    };

    /// <summary>Carga maior que a de todos os dias anteriores (o primeiro dia não conta).</summary>
    private static bool Recorde(IReadOnlyList<PontoDeEvolucao> pontos, int indice) =>
        indice > 0 && pontos[indice].CargaMaximaKg > pontos.Take(indice).Max(p => p.CargaMaximaKg);

    private sealed record EscalaY(double Min, double Max, IReadOnlyList<double> Marcas);

    /// <summary>Faixa com folga e marcas "redondas" (1, 2, 2,5 ou 5 × 10ⁿ). Não começa no zero: o que importa é a variação.</summary>
    private EscalaY Escala(IReadOnlyList<PontoDeEvolucao> pontos)
    {
        var valores = pontos.Select(p => (double)Medir(p)).ToList();
        var min = valores.Min();
        var max = valores.Max();
        if (max - min < 1e-9)
        {
            min = Math.Max(0, min - Math.Max(1, Math.Abs(min) * 0.1));
            max += Math.Max(1, Math.Abs(max) * 0.1);
        }

        var bruto = (max - min) / 3;
        var potencia = Math.Pow(10, Math.Floor(Math.Log10(bruto)));
        var passo = new[] { 1, 2, 2.5, 5, 10 }.Select(f => f * potencia).First(p => p >= bruto);
        var inicio = Math.Max(0, Math.Floor(min / passo) * passo);
        var fim = Math.Ceiling(max / passo) * passo;
        var marcas = new List<double>();
        for (var v = inicio; v <= fim + passo / 1000; v += passo)
        {
            marcas.Add(Math.Round(v, 6));
        }

        return new EscalaY(inicio, fim, marcas);
    }

    private static double X(int indice, int total) =>
        total == 1 ? EsqX + (L - EsqX - DirX) / 2 : EsqX + indice * (L - EsqX - DirX) / (total - 1);

    private static double Y(decimal valor, EscalaY escala) => Y((double)valor, escala);

    private static double Y(double valor, EscalaY escala) =>
        A - BaseY - (valor - escala.Min) / (escala.Max - escala.Min) * (A - BaseY - TopoY);

    /// <summary>Datas no eixo: o primeiro e o último dia e, com muitos dias, o do meio.</summary>
    private static IEnumerable<int> RotulosDeData(int total) =>
        total switch
        {
            1 => [0],
            < 5 => Enumerable.Range(0, total),
            _ => [0, total / 2, total - 1],
        };

    private static string Curta(DateTimeOffset data) => data.ToLocalTime().ToString("dd/MM", CultureInfo.GetCultureInfo("pt-BR"));

    private static string Marca(double valor) => valor >= 10000 ? $"{valor / 1000:0.#}k" : valor.ToString("0.#", CultureInfo.GetCultureInfo("pt-BR"));

    /// <summary>Número para atributo SVG (sempre com ponto decimal).</summary>
    private static string N(double valor) => valor.ToString("0.##", CultureInfo.InvariantCulture);
}
