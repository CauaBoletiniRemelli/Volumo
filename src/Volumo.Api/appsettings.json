{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Global": { "PermitLimit": 100, "WindowSeconds": 60 },
    "Login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Cadastro": { "PermitLimit": 3, "WindowSeconds": 600 }
  }
}
