{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Volumo": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Front": {
    "BaseUrl": ""
  },
  "Email": {
    "Provider": ""
  },
  "Turnstile": {
    "SecretKey": ""
  },
  "RateLimiting": {
    "Global": { "PermitLimit": 100, "WindowSeconds": 60 },
    "Login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Cadastro": { "PermitLimit": 3, "WindowSeconds": 600 }
  }
}
